DB_PATH=./calculon.db

# Who the local dashboard and imports act as. Optional while only one user exists.
CALCULON_USER=

# SSH server (`calculon serve`). The host key is generated on first start.
SSH_ADDR=:23234
SSH_HOST_KEY=./.ssh/calculon_ed25519

# Totals are shown in BASE_CURRENCY. Until a rates API exists, other currencies
# convert at these static rates: units of base per one unit of the currency.
BASE_CURRENCY=PLN
FX_RATES=USD=3.65,EUR=4.26

# Finimpulse market data API. BASE_URL is required: commands refuse to start
# without it.
FINIMPULSE_BASE_URL=
FINIMPULSE_TOKEN=
# How often held symbols are priced while the dashboards or server run.
FINIMPULSE_POLL_INTERVAL=15m
# News (press r on the News tab): up to PER_SYMBOL articles for each of the
# POSITIONS biggest holdings, searching LOOKBACK back for a symbol without any.
FINIMPULSE_NEWS_POSITIONS=5
FINIMPULSE_NEWS_PER_SYMBOL=5
FINIMPULSE_NEWS_LOOKBACK=720h
